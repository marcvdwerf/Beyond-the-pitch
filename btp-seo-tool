// Generate buttons
document.querySelectorAll('.btn-generate').forEach(btn => {
  btn.addEventListener('click', async () => {
    const mode = btn.dataset.mode;
    const prompt = buildPrompt(mode);

    const outputBox = document.getElementById('output-box');
    const loading = document.getElementById('loading');
    const outputContent = document.getElementById('output-content');
    const outputLabel = document.getElementById('output-label');

    outputBox.classList.remove('visible');
    loading.classList.add('visible');
    btn.disabled = true;

    const modeLabels = { seo: 'SEO Output', geo: 'GEO Output', sea: 'SEA Output', combined: 'Volledige Strategie' };
    outputLabel.textContent = modeLabels[mode] || 'Output';

    try {
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          system: "Je bent een expert digital marketing strateeg gespecialiseerd in niche travel. Schrijf altijd direct bruikbare, specifieke output. Geen uitleg over wat je gaat doen — gewoon de output. Gebruik heldere kopjes, witruimte en concrete voorbeelden. Schrijf in de taal van de doelmarkt tenzij anders gevraagd.",
          messages: [{ role: "user", content: prompt }]
        })
      });

      const data = await response.json();
      const text = data.content?.map(c => c.text || '').join('') || 'Geen output ontvangen.';

      outputContent.textContent = text;
      loading.classList.remove('visible');
      outputBox.classList.add('visible');
    } catch (err) {
      outputContent.textContent = 'Er ging iets mis: ' + err.message;
      loading.classList.remove('visible');
      outputBox.classList.add('visible');
    }

    btn.disabled = false;
  });
});
</script>
