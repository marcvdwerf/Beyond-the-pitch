<script>
// Pill toggle
document.querySelectorAll('.pill-label').forEach(label => {
  label.addEventListener('click', () => {
    label.classList.toggle('checked');
  });
});

// Tab switching
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const tab = btn.dataset.tab;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
    document.getElementById('output-box').classList.remove('visible');
  });
});

// Copy button
document.getElementById('copy-btn').addEventListener('click', () => {
  const text = document.getElementById('output-content').innerText;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'GEKOPIEERD ✓';
    setTimeout(() => btn.textContent = 'KOPIEER', 2000);
  });
});

// Gather checked pills
function getChecked(groupId) {
  return Array.from(document.querySelectorAll(`#${groupId} .pill-label.checked input`))
    .map(i => i.value).join(', ');
}

// Build prompts
function buildPrompt(mode) {
  const brand = `Beyond the Pitch (travelbeyondthepitch.com) – een sport-cultuur ervaringsbedrijf dat kleine groepsreizen aanbiedt rondom authentieke lokale sportcultuur. Producten: Prague Ice Hockey Experience (lokale Tsjechische ijshockeycultuur, gids Kamil), Gaelic Games Kilkenny & Dublin (hurling/GAA cultuur, gids James), en Naadam Mongolia (coming soon). Doelgroep: cultureel nieuwsgierige, avontuurlijke reizigers van 28-55 jaar die sport als cultuurlens zien. Unique selling points: small-group, insider access, authentieke locals, geen toeristische bubbel.`;

  if (mode === 'seo') {
    const product = document.getElementById('seo-product').value;
    const market = document.getElementById('seo-market').value;
    const types = getChecked('seo-types');
    const context = document.getElementById('seo-context').value;
    return `Je bent een expert SEO-strateeg gespecialiseerd in niche travel en sport-cultuurreizen.

MERK: ${brand}

PRODUCT FOCUS: ${product}
DOELMARKT / TAAL: ${market}
GEWENSTE OUTPUT: ${types}
${context ? 'EXTRA CONTEXT: ' + context : ''}

INSTRUCTIES:
1. Maak een SEO-strategie die specifiek is voor dit product en deze markt. Geen generieke tips.
2. Focus op search intent: wat zoekt iemand die dit soort reis overweegt?
3. Verwerk de volgende elementen waar gevraagd:

KEYWORD CLUSTERS: Geef 3-4 clusters met elk 5-8 zoekwoorden. Onderscheid: (a) informatief/oriënterend, (b) transactioneel/boekingsgericht, (c) long-tail niche. Geef voor elk zoekwoord een inschatting van moeilijkheidsgraad (laag/middel/hoog) en intent.

META TITLE & DESCRIPTION: Schrijf 3 varianten van de meta title (max 60 tekens) en meta description (max 155 tekens). Verwerk primair zoekwoord, USP en call-to-action. Schrijf in de taal van de doelmarkt.

H1/H2 STRUCTUUR: Stel een complete pagina-structuur voor met H1, minimaal 4 H2's en bijbehorende subvragen die als H3 kunnen dienen. Onderbouw waarom elke sectie bijdraagt aan SEO én conversie.

CONTENT BRIEF: Geef een content brief van 300-400 woorden voor een kerntekst. Beschrijf: doel, invalshoek, tone of voice, te behandelen onderwerpen, interne links, en één concrete storytelling-hook om de pagina onderscheidend te maken.

SCHEMA MARKUP: Welke structured data types zijn het meest relevant (TouristAttraction, Event, FAQPage, Review)? Geef concrete voorbeeldvelden.

INTERNE LINKSTRUCTUUR: Stel 5-8 interne links voor met ankertekst en bestemming. Hoe verbindt deze pagina zich logisch aan de rest van de site?

Sluit af met: de 3 meest impactvolle quick wins voor deze pagina op korte termijn.`;
  }

  if (mode === 'geo') {
    const product = document.getElementById('geo-product').value;
    const platform = document.getElementById('geo-platform').value;
    const types = getChecked('geo-types');
    const query = document.getElementById('geo-query').value;
    return `Je bent een expert in Generative Engine Optimization (GEO) – de praktijk van content optimaliseren zodat AI-modellen zoals ChatGPT, Perplexity, Claude en Google AI Overviews jouw merk en content citeren als autoriteit.

MERK: ${brand}

PRODUCT FOCUS: ${product}
